# Supabase (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (dashboard.stripe.com)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe price IDs (server-side only — do NOT prefix with NEXT_PUBLIC_)
# Create these in Stripe Dashboard > Products
STRIPE_PRICE_VAULT_MONTHLY=price_xxx   # MoveProof Vault — Monthly ($9.99/mo)
STRIPE_PRICE_VAULT_ANNUAL=price_xxx    # MoveProof Vault — Annual ($79/yr)
STRIPE_PRICE_PACK_ONETIME=price_xxx    # Evidence Pack — One-time ($39)
